# ==== Supabase (Frontend public keys) ====
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ==== Anthropic Claude (used via secure backend proxy) ====
# Note: NEVER ship the raw Anthropic key to the browser.
# Wire it on a backend route (Express / Supabase Edge Function).
ANTHROPIC_API_KEY=

# ==== Eskiz SMS (OTP + parent notifications) — backend only ====
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# ==== Payments (Payme / Click) — backend only ====
PAYME_MERCHANT_ID=
PAYME_SECRET=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET=

# ==== STT (used by grade-speaking edge function) ====
OPENAI_API_KEY=

# ==== Payme front-end checkout (public) ====
VITE_PAYME_MERCHANT_ID=

# ==== Click front-end checkout (public) ====
VITE_CLICK_MERCHANT_ID=
VITE_CLICK_SERVICE_ID=

# ==== Backend-only Payme/Click secrets ====
PAYME_MERCHANT_KEY=
CLICK_SECRET=

# ==== OTP hashing salt (set once, never change for live data) ====
OTP_SALT=lingrow-prod-salt-please-rotate

# ==== Daily-report cron secret (must match the X-Cron-Secret header) ====
DAILY_REPORT_SECRET=

# ==== Anthropic model override (optional) ====
ANTHROPIC_MODEL=claude-haiku-4-5

# ==== Eskiz "from" sender id (default 4546 = test) ====
ESKIZ_FROM=4546

# ==== Demo / mock toggles ====
VITE_USE_MOCK_API=true
